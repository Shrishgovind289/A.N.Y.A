ANYA_NAME=A.N.Y.A
ANYA_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434

ANYA_API_KEY=replace_with_a_long_random_key

ANYA_MAX_OUTPUT_TOKENS=1024
ANYA_TEMPERATURE=0.4
ANYA_KEEP_ALIVE=10m
ANYA_MAX_TOOL_ITERATIONS=3

ANYA_ALLOWED_PATHS=/
ANYA_DENIED_PATHS=/home/your-user/.ssh,/home/your-user/.gnupg,/proc,/sys,/dev,/run
ANYA_MAX_FILE_BYTES=262144

ANYA_WEB_TIMEOUT_SECONDS=15
ANYA_MAX_WEBPAGE_BYTES=1048576
